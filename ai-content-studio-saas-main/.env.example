# Copy this file to .env and fill in real values.
# NEVER commit .env — it is in .gitignore.

# ── Core secrets (generate with: openssl rand -hex 32) ──────────────────────
ENCRYPTION_SECRET=
SESSION_SECRET=

# ── App URL ──────────────────────────────────────────────────────────────────
APP_URL=http://127.0.0.1:3001

# ── Admin seed account (used on first run to create admin user) ───────────────
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_NAME=Admin

# ── API keys (server-side only, never expose to client) ──────────────────────
GEMINI_API_KEY=
API_KEY=
APIFY_TOKEN=

# ── Email — Resend (recommended) or SMTP ─────────────────────────────────────
RESEND_API_KEY=
MAIL_FROM=

# -- SMTP (alternative to Resend) ---------------------------------------------
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ── Billing — Heleket ────────────────────────────────────────────────────────
HELEKET_API_KEY=
HELEKET_MERCHANT_ID=

# ── One-time admin bootstrap (delete after first use) ────────────────────────
BOOTSTRAP_SECRET=
