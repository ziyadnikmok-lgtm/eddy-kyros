# Kyros Studio — Environment Configuration
# Copy this file to .env and fill in your values

# Security (auto-generated on first boot if empty)
ENCRYPTION_SECRET=
SESSION_SECRET=
SERVER_ENCRYPTION_KEY=

# Admin account seeding (optional)
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_USERNAME=
SEED_ADMIN_NAME=

# App URL
APP_URL=http://localhost:3001
REMOTE_URL=

# AI API Keys (add via Settings page in the app)
# GEMINI_API_KEY=
# OPENROUTER_API_KEY=

# Email (optional — Resend)
RESEND_API_KEY=
MAIL_FROM=Kyros Studio <onboarding@resend.dev>
