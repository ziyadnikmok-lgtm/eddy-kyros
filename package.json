{
  "name": "ai-content-studio",
  "version": "8.1.0",
  "description": "Local AI Content Generation Studio - Backend",
  "main": "electron/main.js",
  "scripts": {
    "start": "node server/index.js",
    "build": "cd client && npm install && npm run build",
    "dev": "node --watch server/index.js",
    "recovery": "node electron/recovery-launch.js",
    "build:client": "cd client && npm run build",
    "rebuild:electron": "electron-rebuild -f -w better-sqlite3",
    "build:exe": "npm run build:client && npx electron-builder --win portable",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"server/**/*.js\" \"client/src/**/*.{js,jsx}\""
  },
  "dependencies": {
    "@google/genai": "^1.43.0",
    "apify-client": "^2.22.2",
    "archiver": "^7.0.1",
    "axios": "^1.13.6",
    "axios-cookiejar-support": "^6.0.5",
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^12.8.0",
    "better-sqlite3-session-store": "^0.1.0",
    "cheerio": "^1.2.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.2.1",
    "express-session": "^1.19.0",
    "ffmpeg-static": "^5.3.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "nodemailer": "^8.0.4",
    "otpauth": "^9.5.0",
    "playwright": "^1.59.1",
    "puppeteer": "^24.37.5",
    "sharp": "^0.33.5",
    "tough-cookie": "^6.0.1",
    "uuid": "^13.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.3",
    "electron": "^40.8.0",
    "electron-builder": "^26.8.1",
    "eslint": "^9.39.3",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.3.0",
    "prettier": "^3.8.1",
    "vitest": "^4.0.18"
  }
}
